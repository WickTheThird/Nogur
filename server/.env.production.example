# Generate once with: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=nogur
POSTGRES_USER=nogur

# Use: postgresql+asyncpg://nogur:<same password>@postgres:5432/nogur
# A generated hex password is already URL-safe.
NOGUR_DATABASE_URL=

# Generate separately with: openssl rand -hex 32
NOGUR_JWT_SECRET=

# Match static-auth-secret in coturn. Leave both blank until coturn is deployed.
NOGUR_TURN_URLS=
NOGUR_TURN_SHARED_SECRET=

# Copy only the eyJ... token from Cloudflare's Docker installation command.
CLOUDFLARE_TUNNEL_TOKEN=
