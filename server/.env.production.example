# Generate once with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-hex-value
POSTGRES_DB=nogur
POSTGRES_USER=nogur

# Keep the password here identical to POSTGRES_PASSWORD. A hex value is already
# URL-safe, which avoids password-encoding mistakes in this connection string.
NOGUR_DATABASE_URL=postgresql+asyncpg://nogur:replace-with-the-same-random-hex-value@postgres:5432/nogur

# Generate separately with: openssl rand -hex 32
NOGUR_JWT_SECRET=replace-with-another-random-hex-value

# Copy only the eyJ... token from Cloudflare's Docker installation command.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-the-cloudflare-tunnel-token
