NOGUR_APP_NAME=Nogur API
NOGUR_APP_ENV=development
NOGUR_DEBUG=false
NOGUR_API_PREFIX=/v1
NOGUR_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nogur
NOGUR_REDIS_URL=redis://localhost:6379/0
NOGUR_JWT_SECRET=
NOGUR_ACCESS_TOKEN_EXPIRE_MINUTES=15
NOGUR_REFRESH_TOKEN_EXPIRE_DAYS=30
NOGUR_PRESENCE_TTL_SECONDS=120
NOGUR_WEBSOCKET_TICKET_TTL_SECONDS=30
NOGUR_DEVICE_CHALLENGE_TTL_SECONDS=120
NOGUR_DEVICE_TOKEN_EXPIRE_DAYS=30
NOGUR_SESSION_REQUEST_TTL_SECONDS=120
NOGUR_STUN_URLS=stun:stun.l.google.com:19302
NOGUR_TURN_URLS=
NOGUR_TURN_SHARED_SECRET=
NOGUR_TURN_CREDENTIAL_TTL_SECONDS=600
